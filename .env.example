# 이 파일은 템플릿입니다(커밋 대상). 실제 키는 `.env.local` 에 복사해서 채우세요.
# `.env.local` 은 .gitignore 로 제외되어 GitHub에 올라가지 않습니다.

# ── 브라우저에 공개되는 값 (NEXT_PUBLIC_ 접두사) ─────────────────────────────
# 카카오 JavaScript 키. 지도 SDK 로드에 쓰이며 원래 공개되는 키입니다.
# 대신 카카오 개발자 콘솔 > 플랫폼 > Web 에 허용 도메인(http://localhost:3000)을 꼭 등록하세요.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ── 서버 전용 비밀 키 (접두사 없음 → 브라우저로 절대 전달되지 않음) ──────────────
# 서울 열린데이터광장 인증키 (따릉이 대여소 실시간 정보)
SEOUL_OPEN_API_KEY=
# 공공데이터포털 일반 인증키 (기상청 실황, 도로교통공단 자전거사고)
DATA_GO_KR_SERVICE_KEY=
# 카카오 REST API 키 (장소 검색)
KAKAO_REST_API_KEY=

# OpenRouteService 키 (자전거 경로). 설정하면 카카오모빌리티 대신 이 API를 사용합니다. 선택 사항.
# 발급: openrouteservice.org 계정 대시보드
ORS_API_KEY=
